{
  "name": "@try/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "generate": "drizzle-kit generate",
    "lint": "eslint src",
    "migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "seed:media": "tsx --env-file-if-exists=../../.env src/scripts/seed-media.ts",
    "studio": "drizzle-kit studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@try/contracts": "workspace:*",
    "@try/utils": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@try/eslint-config": "workspace:*",
    "@try/typescript-config": "workspace:*",
    "@types/node": "22.10.5",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "files": [
    "dist"
  ]
}
