{
  "name": "@try/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "studio": "drizzle-kit studio",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@try/contracts": "workspace:*",
    "@try/utils": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@try/eslint-config": "workspace:*",
    "@try/typescript-config": "workspace:*",
    "@types/node": "22.10.5",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
