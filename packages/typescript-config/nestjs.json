{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "TRY NestJS",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "outDir": "dist",
    "rootDir": "src",
    "isolatedModules": false,
    "verbatimModuleSyntax": false
  }
}
