{
  "name": "@try/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi": "tsx src/scripts/generate-openapi.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.0",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-fastify": "11.2.1",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.6",
    "@try/config": "workspace:*",
    "@try/contracts": "workspace:*",
    "@try/database": "workspace:*",
    "@try/logger": "workspace:*",
    "@try/utils": "workspace:*",
    "drizzle-orm": "0.45.2",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "stripe": "22.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.5",
    "@nestjs/schematics": "11.0.2",
    "@nestjs/testing": "11.2.1",
    "@try/eslint-config": "workspace:*",
    "@try/typescript-config": "workspace:*",
    "@types/node": "22.10.5",
    "eslint": "9.39.5",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
