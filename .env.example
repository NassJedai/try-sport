# TRY — environment template
#
# Copy to .env and fill in. The API validates every one of these at startup and
# refuses to boot if something required is missing or malformed, so a bad deploy
# fails immediately rather than at the first booking.
#
# Never commit a filled-in .env.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
APP_ENV=local                  # local | development | staging | production
NODE_ENV=development
PORT=3000
API_PUBLIC_URL=http://localhost:3000
# Origine du tableau de bord des salles, pour les liens de correction dans les
# e-mails (décision de modération, relance de dossier incomplet).
BUSINESS_PUBLIC_URL=http://localhost:3001
LOG_LEVEL=debug                # fatal | error | warn | info | debug | trace

# ---------------------------------------------------------------------------
# Database — Postgres 15+ with the PostGIS extension available
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://try:try@localhost:5432/try_dev
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL=false             # true for Neon/managed Postgres

# Base visée par `pnpm test:integration`. Facultative : à défaut, elle est
# DÉRIVÉE de DATABASE_URL en suffixant `_test` au nom de la base.
#
# La suite d'intégration sème et détruit des données. Elle REFUSE de démarrer
# si la base résolue est celle de développement — le 27 août 2026, avant cette
# garde, elle y avait laissé 116 lieux « Test Venue » sur 144.
#
# Créer la base une fois :
#   createdb try_dev_test && psql -d try_dev_test -c 'CREATE EXTENSION postgis'
#   DATABASE_URL=postgres://.../try_dev_test pnpm db:migrate && pnpm db:seed
# TEST_DATABASE_URL=postgres://try:try@localhost:5432/try_dev_test

# ---------------------------------------------------------------------------
# Redis — optional locally (in-memory fallback), REQUIRED in staging/production
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth
#
# Generate with: openssl rand -base64 48
# Two distinct secrets: rotating session signing must not invalidate every
# outstanding QR check-in code.
# ---------------------------------------------------------------------------
JWT_SECRET=replace-me-with-at-least-32-random-characters
CHECKIN_TOKEN_SECRET=replace-me-with-a-different-32-plus-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# Prints login codes to the log so a developer without a mail server can sign in.
# Configuration REFUSES TO BOOT with this enabled outside APP_ENV=local.
AUTH_DEV_ECHO_OTP=true

# ---------------------------------------------------------------------------
# CORS — explicit allowlist. "*" is rejected in production.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# ---------------------------------------------------------------------------
# Stripe — required in staging/production. Without it, paid bookings are
# refused with a clear error rather than silently "succeeding".
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------------
# Storage / CDN — images are stored by key and the URL composed at read time,
# so moving CDN is a config change rather than a data migration.
#
# Laisser STORAGE_PUBLIC_BASE_URL absent en local : l'API dérive alors une URL
# à partir de l'adresse réseau réellement utilisée par cette machine (voir
# `guessLanAddress` dans packages/config/src/index.ts), exactement comme
# l'app mobile déduit l'adresse de l'API depuis l'hôte Expo
# (apps/mobile/src/api/client.ts:50-71). Une valeur figée ici — une IP
# recopiée un jour donné — casse dès que la box redistribue les adresses : les
# photos deviennent injoignables sans qu'aucune erreur ne le signale.
# En préproduction et en production, cette variable est en revanche
# OBLIGATOIRE et doit pointer vers le CDN : deviner une adresse de CDN serait
# dangereux, l'API refuse de démarrer sans elle dans ces environnements.
# STORAGE_PUBLIC_BASE_URL=http://localhost:3000/media
STORAGE_BUCKET=try-media
# Répertoire local des fichiers uploadés (dev). En prod : stockage objet + CDN.
MEDIA_DIR=.media

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Nom affiché de l'expéditeur : c'est la marque, donc TRIALYA. Le domaine reste
# technique. Voir la section « Marque et nommage » de CLAUDE.md.
EMAIL_FROM=TRIALYA <hello@try.local>
# RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# SENTRY_DSN=

RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# Web apps (Next.js) — must be NEXT_PUBLIC_ to reach the browser
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000
